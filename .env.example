# EDGEZEN AI Club Management Platform Environment Variables

# Supabase Credentials (Optional - App falls back seamlessly to LocalState Engine if omitted)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server Port
PORT=3000

# PostgreSQL Connection String (For Docker / Backend Database link)
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/edgezen_db
